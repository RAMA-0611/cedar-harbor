# ─────────────────────────────────────────────────────────────────────────────
# Proyecto Rotor · variables de entorno del despliegue con Docker
# Copie este archivo a ".env" (que Git ignora) y complete los valores.
# NUNCA escriba credenciales reales en este archivo: aquí solo van los NOMBRES.
#
# En local NO hace falta .env: "docker compose up --build" usa valores de desarrollo.
# En producción cada variable marcada (obligatoria) debe estar definida.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proxy / dominio ──────────────────────────────────────────────────────────
# Local: http://localhost  ·  Producción: solo el dominio (Caddy emite el certificado HTTPS)
SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME="Proyecto Rotor"
APP_ENV=production
APP_DEBUG=false
# URL pública con esquema. Producción (obligatoria): https://su-dominio
APP_URL=http://localhost:8080
# Clave de cifrado de Laravel. Producción (obligatoria): php artisan key:generate --show
# Local: si queda vacía se genera sola y se guarda en el volumen de storage.
APP_KEY=
LOG_LEVEL=info
# Dominio(s) de la SPA sin esquema. Local por defecto: localhost:8080. Producción (obligatoria): su-dominio
SANCTUM_STATEFUL_DOMAINS=
# true cuando se sirve por HTTPS
SESSION_SECURE_COOKIE=false

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_DB=rotor
POSTGRES_USER=rotor
# Producción (obligatoria). Local: valor de desarrollo si queda vacía.
POSTGRES_PASSWORD=

# ── Primer administrador y datos de demostración ─────────────────────────────
ADMIN_EMAIL=admin@rotor.test
# Producción (obligatoria). Si queda vacía en local, se genera una contraseña y se imprime UNA vez en el log de "app".
ADMIN_PASSWORD=
# true = carga el catálogo de demostración cuando la base está vacía
SEED_DEMO=true

# ── Pagos ────────────────────────────────────────────────────────────────────
# simulated = pasarela de práctica incluida (no mueve dinero) · wompi = Wompi sandbox/producción
PAYMENT_PROVIDER=simulated
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ── Imágenes (las completa el flujo CI/CD en producción) ─────────────────────
APP_IMAGE=rotor-app:local
WEB_IMAGE=rotor-web:local
