  CART ||--o{ STOCK_RESERVATION : "orquesta: 1 a 0..N"
  CART_ITEM o|--o{ STOCK_RESERVATION : "línea: 0..1 a 0..N"
  ORDER ||--o{ ORDER_ITEM : "snapshot: 1 a 1..N por regla"
  ORDER ||--o{ PAYMENT : "intentos: 1 a 0..N"
  ORDER o|--o{ STOCK_RESERVATION : "retiene: 0..1 a 0..N"
  ORDER o|--o{ WEBHOOK_EVENT : "correlaciona: 0..1 a 0..N"
