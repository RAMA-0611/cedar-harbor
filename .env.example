# Project Rotor — configuración de referencia
# Nunca almacenar credenciales reales en este archivo.
# Referencia pública y sintética del proyecto; no reemplaza backend/.env.example.

APP_ENV=local
APP_URL=http://127.0.0.1:8000
WEB_URL=http://127.0.0.1:8091

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rotor
DB_USERNAME=rotor
DB_PASSWORD=

PAYMENT_PROVIDER=sandbox
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
